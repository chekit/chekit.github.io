section#intro
	.wrapper
		.hero-content.reveal-on-scroll
			.hero-content__eyebrow
				span 01
				span /
				span Digital CV / Frontend systems
			.hero-content__status
				span.status-dot
				span Available for ambitious interfaces

			h1.hero-content__title
				| Anton
				br
				span.title-gradient Cherepov

			h2.hero-content__role
				| Senior Front-End Developer &amp; Platform Engineer

			p.hero-content__bio
				| I design and build calm, fast interfaces for complicated products, from the first sharp idea to the last reliable interaction. <strong>15+ years</strong> of making the web useful.

			.hero-content__actions
				a.btn.btn-primary(href="#experience")
					| View Experience &darr;
				a.btn.btn-secondary(href="#contact")
					| Get in Touch &rarr;
				.cv-buttons
					span.cv-buttons__label CV:
					a.cv-buttons__link(href="files/cv_cherepov_aa_en.pdf", target="_blank") EN
					a.cv-buttons__link(href="files/cv_cherepov_aa_ru.pdf", target="_blank") RU

			.hero-content__tech-strip
				span.hero-content__tech-strip-label Core Stack:
				.tag-list
					span.tag.tag--sm.is-advanced TypeScript
					span.tag.tag--sm.is-advanced Angular
					span.tag.tag--sm.is-advanced React.js
					span.tag.tag--sm.is-advanced Node.js
					span.tag.tag--sm.is-advanced RxJS
					span.tag.tag--sm.is-advanced Vite

		.hero-terminal-container.reveal-on-scroll
			.hero-note
				.hero-note__index 15+
				.hero-note__label years turning complexity into clarity
			.terminal
				.terminal__header
					.terminal__buttons
						span.btn-close
						span.btn-minimize
						span.btn-maximize
					.terminal__title dev-profile.ts
					.terminal__status active
				.terminal__body
					pre.terminal__code
						span.tok-keyword const
						span.tok-var  developer
						span.tok-punct = {
						|
						span.tok-prop  name
						span.tok-punct :
						span.tok-str  'Anton Cherepov'
						span.tok-punct ,
						|
						span.tok-prop  role
						span.tok-punct :
						span.tok-str  'Senior Front-End Developer'
						span.tok-punct ,
						|
						span.tok-prop  location
						span.tok-punct :
						span.tok-str  'Diemen, Netherlands'
						span.tok-punct ,
						|
						span.tok-prop  experience
						span.tok-punct :
						span.tok-str  '15+ Years'
						span.tok-punct ,
						|
						span.tok-prop  current
						span.tok-punct :
						span.tok-str  'Rabobank (Platform team)'
						span.tok-punct ,
						|
						span.tok-prop  skills
						span.tok-punct : [
						span.tok-str 'TS'
						span.tok-punct ,
						span.tok-str 'Angular'
						span.tok-punct ,
						span.tok-str 'NX'
						span.tok-punct ,
						span.tok-str 'Node'
						span.tok-punct ],
						|
						span.tok-prop  principles
						span.tok-punct : [
						span.tok-str 'S.O.L.I.D.'
						span.tok-punct ,
						span.tok-str 'Clean Code'
						span.tok-punct ,
						span.tok-str 'Performance'
						span.tok-punct ],
						|
						span.tok-prop  status
						span.tok-punct :
						span.tok-str  'Open to Innovations'
						|
						span.tok-punct  };
						span.cursor-blink

	a.scroll-indicator(href="#about", aria-label="Scroll to About section")
		.scroll-indicator__mouse
		span SCROLL
