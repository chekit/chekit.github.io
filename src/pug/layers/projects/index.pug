//- Boilerplate
- var gbp = {};
- gbp.name = 'Generator Basic Page';
- gbp.image = 'https://raw.githubusercontent.com/chekit/generator-basic-page/master/logo.jpg';
- gbp.description = ['Modern boilerplate tool to scaffold and build web interfaces with Pug, SCSS, TypeScript, and modular task orchestration.'];
- gbp.link = [{href: 'https://github.com/chekit/generator-basic-page', title: 'View on GitHub'}];
- gbp.techstack = ['Pug', 'SCSS', 'TypeScript', 'Gulp', 'Babel', 'Architecture'];

//- Split File
- var sfjs = {};
- sfjs.name = 'split-file-js';
- sfjs.image = 'https://raw.githubusercontent.com/chekit/split-file-js/master/scissors.png';
- sfjs.description = ['Lightweight Node.js utility and package designed to parse and split large HTML documents into optimized modular chunks.'];
- sfjs.link = [{href: 'https://github.com/chekit/split-file-js', title: 'View on GitHub'}];
- sfjs.techstack = ['JavaScript', 'Node.js', 'npm', 'CLI'];

//- XLF2XLF
- var xlf2xlf = {};
- xlf2xlf.name = 'XLF2XLF (ex. google-translate-xlf)';
- xlf2xlf.image = 'https://github.com/chekit/xlf2xlf/raw/master/logo.png';
- xlf2xlf.description = ['Command-line developer utility to automatically translate Angular i18n .xlf localization files with Google Translate.'];
- xlf2xlf.link = [{href: 'https://github.com/chekit/xlf2xlf', title: 'View on GitHub'}];
- xlf2xlf.techstack = ['JavaScript', 'Node.js', 'npm', 'Angular', 'i18n'];

section#projects
	.wrapper
		.section-heading.reveal-on-scroll
			span.section-heading__tag 04. Showcase
			h2.section-heading__title
				| Open Source 
				span.highlight &amp; Projects
			p.section-heading__subtitle
				| Selected open-source packages, developer utilities, and tools I have engineered.

		+project([gbp, xlf2xlf, sfjs])

